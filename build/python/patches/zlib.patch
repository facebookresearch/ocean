Install only the library kind that was asked for, under the name consumers look for.

zlib's CMakeLists declares both targets with an explicit keyword --
`add_library(zlib SHARED ...)` and `add_library(zlibstatic STATIC ...)` -- so
BUILD_SHARED_LIBS has no effect on either. zlib reads it in exactly one place,
to decide whether the DLL gets a `1.dll` suffix. Both targets are then
installed unconditionally.

On Windows that puts three files in a static install prefix: zlib.dll, zlib.lib
(the import library for that DLL) and zlibstatic.lib (the real static library).
Import libraries and static libraries share the .lib extension, so a consumer
has no way to tell them apart, links the import library, and fails at load
because the DLL is not in the static prefix.

Gate the install on BUILD_SHARED_LIBS so the prefix holds one kind only, and
give that kind the short name used by Ocean's consumers. In particular,
assimp's bundled FindZLIB module searches zlib and zlibd but not zlibstatic.

No Unix output rename is needed: both targets already carry OUTPUT_NAME z, and
.a against .dylib/.so distinguishes them. The install gating still applies on
every platform so each staging prefix contains only the requested link type.

diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -173,16 +173,33 @@ if(UNIX)
    if(NOT APPLE AND NOT(CMAKE_SYSTEM_NAME STREQUAL AIX))
      set_target_properties(zlib PROPERTIES LINK_FLAGS "-Wl,--version-script,\"${CMAKE_CURRENT_SOURCE_DIR}/zlib.map\"")
    endif()
-elseif(BUILD_SHARED_LIBS AND WIN32)
-    # Creates zlib1.dll when building shared library version
-    set_target_properties(zlib PROPERTIES SUFFIX "1.dll")
+elseif(WIN32)
+    if(BUILD_SHARED_LIBS)
+        # Creates zlib1.dll when building shared library version
+        set_target_properties(zlib PROPERTIES SUFFIX "1.dll")
+    else()
+        # Use the short static archive name consumed by Ocean and assimp. Give
+        # the shared target's import library a distinct name in case an IDE
+        # builds that excluded target explicitly.
+        set_target_properties(zlibstatic PROPERTIES OUTPUT_NAME zlib)
+        set_target_properties(zlib PROPERTIES
+            ARCHIVE_OUTPUT_NAME zlibdll
+            EXCLUDE_FROM_ALL TRUE)
+    endif()
 endif()
 
 if(NOT SKIP_INSTALL_LIBRARIES AND NOT SKIP_INSTALL_ALL )
-    install(TARGETS zlib zlibstatic
-        RUNTIME DESTINATION "${INSTALL_BIN_DIR}"
-        ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
-        LIBRARY DESTINATION "${INSTALL_LIB_DIR}" )
+    if(BUILD_SHARED_LIBS)
+        install(TARGETS zlib
+            RUNTIME DESTINATION "${INSTALL_BIN_DIR}"
+            ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
+            LIBRARY DESTINATION "${INSTALL_LIB_DIR}" )
+    else()
+        install(TARGETS zlibstatic
+            RUNTIME DESTINATION "${INSTALL_BIN_DIR}"
+            ARCHIVE DESTINATION "${INSTALL_LIB_DIR}"
+            LIBRARY DESTINATION "${INSTALL_LIB_DIR}" )
+    endif()
 endif()
 if(NOT SKIP_INSTALL_HEADERS AND NOT SKIP_INSTALL_ALL )
     install(FILES ${ZLIB_PUBLIC_HDRS} DESTINATION "${INSTALL_INC_DIR}")
